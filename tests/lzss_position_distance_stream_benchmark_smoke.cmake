cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED MARC_BENCHMARK OR NOT DEFINED WORK)
    message(FATAL_ERROR "Benchmark and work directory required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(input "${WORK}/${suffix}.raw")
set(archive "${WORK}/${suffix}.marc")
string(REPEAT "abcabcabc0123456789" 8 pattern)
foreach(size IN ITEMS 0 1 63 64 65 129)
    string(SUBSTRING "${pattern}" 0 ${size} bytes)
    file(WRITE "${input}" "${bytes}")
    file(SHA256 "${input}" input_hash)
    math(EXPR expected_frames "(${size}+63)/64")
    foreach(eligibility RANGE 3 5)
        foreach(search IN ITEMS reference indexed)
            execute_process(COMMAND "${MARC_BENCHMARK}" "${input}" 64 ${eligibility} ${search} 2 "${archive}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Stream benchmark failed: ${size}/${eligibility}/${search}: ${result} ${error}")
            endif()
            file(SHA256 "${archive}" archive_hash)
            file(SIZE "${archive}" archive_size)
            foreach(field IN ITEMS "input_bytes=${size}" "archive_bytes=${archive_size}"
                    "frame_count=${expected_frames}" "eligibility=${eligibility}"
                    "search=${search}" "iterations=2" "verified_iterations=2"
                    "input_sha256=${input_hash}" "archive_sha256=${archive_hash}")
                string(FIND "\n${output}" "\n${field}\n" found)
                if(found EQUAL -1)
                    message(FATAL_ERROR "Missing or incorrect ${field}")
                endif()
            endforeach()
            foreach(key IN ITEMS plan_seconds iteration_0_encode_seconds iteration_0_decode_seconds
                    iteration_1_encode_seconds iteration_1_decode_seconds)
                if(NOT output MATCHES "${key}=[0-9]+[.][0-9]+")
                    message(FATAL_ERROR "Missing timing ${key}")
                endif()
            endforeach()
            if(size EQUAL 0 AND NOT archive_size EQUAL 112)
                message(FATAL_ERROR "Empty stream must contain only its header")
            endif()
            if(search STREQUAL "reference")
                set(reference_hash "${archive_hash}")
            elseif(NOT archive_hash STREQUAL reference_hash)
                message(FATAL_ERROR "Search paths produced different bytes")
            endif()
            execute_process(COMMAND "${MARC_BENCHMARK}" "${input}" 64 ${eligibility} ${search} 1 "${archive}"
                RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
            file(SHA256 "${archive}" preserved_hash)
            if(NOT result EQUAL 2 OR NOT preserved_hash STREQUAL archive_hash)
                message(FATAL_ERROR "Existing output was not preserved")
            endif()
            file(REMOVE "${archive}")
        endforeach()
    endforeach()
endforeach()
foreach(args IN ITEMS "0;3;indexed;1" "65537;3;indexed;1" "64;2;indexed;1"
        "64;6;indexed;1" "64;3;invalid;1" "64;3;indexed;0" "64;3;indexed;11")
    execute_process(COMMAND "${MARC_BENCHMARK}" "${input}" ${args} "${archive}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
    if(NOT result EQUAL 2 OR EXISTS "${archive}")
        message(FATAL_ERROR "Invalid arguments were not rejected")
    endif()
endforeach()
string(REPEAT "x" 1025 bytes)
file(WRITE "${input}" "${bytes}")
execute_process(COMMAND "${MARC_BENCHMARK}" "${input}" 1 3 indexed 1 "${archive}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
if(NOT result EQUAL 2 OR EXISTS "${archive}")
    message(FATAL_ERROR "Frame count limit was not enforced")
endif()
file(REMOVE "${input}")
