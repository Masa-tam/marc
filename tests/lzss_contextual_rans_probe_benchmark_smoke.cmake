cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED BENCHMARK_EXECUTABLE OR NOT DEFINED INPUT_FILE
        OR NOT DEFINED TEST_DIRECTORY)
    message(FATAL_ERROR "benchmark, input and test directory are required")
endif()
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(WRITE "${TEST_DIRECTORY}/empty.bin" "")

function(read_field report key output)
    string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" match "${report}")
    if(match STREQUAL "")
        message(FATAL_ERROR "missing ${key}")
    endif()
    set(${output} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

foreach(input IN ITEMS "${INPUT_FILE}" "${TEST_DIRECTORY}/empty.bin")
    foreach(side IN ITEMS baseline candidate)
        execute_process(COMMAND "${BENCHMARK_EXECUTABLE}"
            "--best-length-probe-${side}" "${input}" 2
            RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error
            TIMEOUT 120)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${side} failed: ${result} ${error}")
        endif()
        read_field("${report}" report_schema schema)
        read_field("${report}" instrumented_token_loop instrumented)
        read_field("${report}" iterations iterations)
        if(NOT schema STREQUAL "lzss-contextual-rans-best-length-probe-v1"
                OR NOT instrumented STREQUAL "0" OR NOT iterations STREQUAL "2")
            message(FATAL_ERROR "invalid comparison report identity")
        endif()
        read_field("${report}" strategy strategy)
        if(side STREQUAL "baseline")
            set(expected_strategy "hash-chain-exact")
        else()
            set(expected_strategy "hash-chain-best-length-probe-exact")
        endif()
        if(NOT strategy STREQUAL expected_strategy)
            message(FATAL_ERROR "wrong strategy: ${strategy}")
        endif()
        foreach(key IN ITEMS input_bytes archive_bytes frame_size window_size
                min_match_length max_match_length encoder_workspace_bytes
                decoder_workspace_bytes codec_peak_workspace_bytes)
            read_field("${report}" "${key}" value)
            if(NOT value MATCHES "^[0-9]+$")
                message(FATAL_ERROR "invalid ${key}")
            endif()
        endforeach()
        foreach(key IN ITEMS input_sha256 archive_sha256)
            read_field("${report}" "${key}" value)
            string(LENGTH "${value}" length)
            if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
                message(FATAL_ERROR "invalid ${key}")
            endif()
        endforeach()
        read_field("${report}" encoded_to_input_ratio ratio)
        if(NOT ratio MATCHES "^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$")
            message(FATAL_ERROR "invalid ratio")
        endif()
        read_field("${report}" encoder_workspace_bytes encoder_bytes)
        read_field("${report}" decoder_workspace_bytes decoder_bytes)
        read_field("${report}" codec_peak_workspace_bytes peak_bytes)
        set(expected_peak "${encoder_bytes}")
        if(decoder_bytes GREATER encoder_bytes)
            set(expected_peak "${decoder_bytes}")
        endif()
        if(NOT peak_bytes EQUAL expected_peak)
            message(FATAL_ERROR "invalid sequential peak workspace")
        endif()
        if(input STREQUAL "${TEST_DIRECTORY}/empty.bin")
            if(NOT ratio STREQUAL "0")
                message(FATAL_ERROR "empty-input ratio must be zero")
            endif()
        endif()
        foreach(key IN ITEMS encode_nanoseconds decode_nanoseconds
                encode_mib_per_second decode_mib_per_second iteration)
            string(REGEX MATCHALL "(^|[\r\n])${key}=([^\r\n]+)" records "${report}")
            list(LENGTH records count)
            if(NOT count EQUAL 2)
                message(FATAL_ERROR "missing per-iteration ${key}")
            endif()
            foreach(record IN LISTS records)
                string(REGEX REPLACE "^[\r\n]*${key}=" "" value "${record}")
                if(NOT value MATCHES "^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$")
                    message(FATAL_ERROR "invalid ${key}: ${value}")
                endif()
            endforeach()
        endforeach()
        if(report MATCHES "tokenize_nanoseconds=|first_plan_nanoseconds=")
            message(FATAL_ERROR "instrumented phases in uninstrumented report")
        endif()
        set(${side}_report "${report}")
    endforeach()
    foreach(key IN ITEMS codec input_bytes input_sha256 archive_bytes archive_sha256
            encoded_to_input_ratio frame_size window_size min_match_length
            max_match_length encoder_workspace_bytes decoder_workspace_bytes
            codec_peak_workspace_bytes)
        read_field("${baseline_report}" "${key}" baseline)
        read_field("${candidate_report}" "${key}" candidate)
        if(NOT baseline STREQUAL candidate)
            message(FATAL_ERROR "comparison mismatch: ${key}")
        endif()
    endforeach()
endforeach()

execute_process(COMMAND "${BENCHMARK_EXECUTABLE}"
    --best-length-probe-candidate "${INPUT_FILE}" 0 RESULT_VARIABLE result
    OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(NOT result STREQUAL "2")
    message(FATAL_ERROR "invalid iteration count was not rejected")
endif()
