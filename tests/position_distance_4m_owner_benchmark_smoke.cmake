if(NOT DEFINED BENCHMARK OR NOT DEFINED WORK)
    message(FATAL_ERROR "Missing diagnostic or workspace")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/empty" "")
string(REPEAT "A" 259 run)
file(WRITE "${WORK}/run" "${run}")
string(REPEAT "abcabcabc0123456789" 227 data)
file(WRITE "${WORK}/small" "${data}")
foreach(member empty run small)
    foreach(profile reference-0 five-prefix reference-1)
        set(archive "${WORK}/${member}-${profile}.marc")
        foreach(mode verify encode decode)
            execute_process(COMMAND "${BENCHMARK}" "${WORK}/${member}" "${profile}" "${mode}" "${archive}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if(NOT result EQUAL 0 OR NOT output MATCHES "verified=1")
                message(FATAL_ERROR "${member}/${profile}/${mode}: ${result} ${error} ${output}")
            endif()
        endforeach()
        file(SHA256 "${archive}" digest)
        if(profile STREQUAL "reference-0")
            set(expected "${digest}")
        elseif(NOT digest STREQUAL expected)
            message(FATAL_ERROR "Owner bytes differ")
        endif()
    endforeach()
endforeach()
