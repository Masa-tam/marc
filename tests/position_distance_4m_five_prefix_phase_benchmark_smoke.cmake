if(NOT DEFINED BENCHMARK OR NOT DEFINED FIXTURE_GENERATOR OR NOT DEFINED WORK)
    message(FATAL_ERROR "Missing diagnostic, fixture generator or workspace")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/empty" "")
string(REPEAT "A" 259 run)
file(WRITE "${WORK}/run" "${run}")
string(REPEAT "abcabcabc0123456789" 227 data)
file(WRITE "${WORK}/small" "${data}")
foreach(member empty run small)
    set(archive "${WORK}/${member}.marc")
    execute_process(COMMAND "${FIXTURE_GENERATOR}" "${WORK}/${member}" position4m-reference verify "${archive}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture generation failed")
    endif()
    foreach(finder reference-0 reference-1 five-prefix)
    foreach(mode verify measure)
        execute_process(COMMAND "${BENCHMARK}" "${WORK}/${member}" "${archive}" "${mode}" "${finder}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0 OR NOT output MATCHES "verified=1" OR NOT output MATCHES "finder_bytes=[0-9]+")
            message(FATAL_ERROR "${member}/${mode}: ${result} ${error} ${output}")
        endif()
        if(mode STREQUAL "verify" AND (NOT output MATCHES "selection_seconds=0" OR NOT output MATCHES "frame_seconds=0"))
            message(FATAL_ERROR "Untimed verification reports timing")
        endif()
    endforeach()
    endforeach()
endforeach()
file(WRITE "${WORK}/bad.marc" "bad")
execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" "${WORK}/bad.marc" verify five-prefix RESULT_VARIABLE result)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Bad header accepted")
endif()
file(COPY_FILE "${WORK}/small.marc" "${WORK}/trailing.marc")
file(APPEND "${WORK}/trailing.marc" "bad")
execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" "${WORK}/trailing.marc" verify five-prefix RESULT_VARIABLE result)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Trailing fixture accepted")
endif()
execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" "${WORK}/small.marc" bad five-prefix RESULT_VARIABLE result)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Bad mode accepted")
endif()
