if(NOT DEFINED BENCHMARK OR NOT DEFINED WORK)
    message(FATAL_ERROR "Missing diagnostic or workspace")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/empty" "")
string(REPEAT "abcabcabc0123456789" 227 data)
file(WRITE "${WORK}/small" "${data}")
foreach(profile position4m-reference position1m-public contextual4m-public)
    foreach(member empty small)
        set(archive "${WORK}/${member}-${profile}.marc")
        foreach(mode verify encode decode)
            execute_process(COMMAND "${BENCHMARK}" "${WORK}/${member}" "${profile}" "${mode}" "${archive}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if(NOT result EQUAL 0 OR NOT output MATCHES "verified=1" OR NOT output MATCHES "minimum_query_budget=[0-9]+")
                message(FATAL_ERROR "${profile}/${member}/${mode}: ${result} ${error} ${output}")
            endif()
            if(mode STREQUAL "verify" AND NOT output MATCHES "seconds=0")
                message(FATAL_ERROR "Verification must not report qualified timing")
            endif()
        endforeach()
        if(member STREQUAL "empty")
            file(SIZE "${archive}" size)
            if(NOT size EQUAL 112)
                message(FATAL_ERROR "Empty stream extent ${size}")
            endif()
        endif()
    endforeach()
endforeach()
foreach(args "bad;verify" "position4m-reference;bad")
    execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" ${args} "${WORK}/unused"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Invalid arguments accepted")
    endif()
endforeach()
file(WRITE "${WORK}/bad.marc" "bad")
execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" position4m-reference decode "${WORK}/bad.marc"
    RESULT_VARIABLE result)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Malformed fixture accepted")
endif()
