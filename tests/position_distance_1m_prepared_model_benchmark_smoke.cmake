cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK}")
foreach(data IN ITEMS x xx xxx abcXabcYabcZ abcdXabcdY abcdeXabcde)
    file(WRITE "${WORK}/small" "${data}")
    foreach(direction IN ITEMS forward reverse)
        execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" "${direction}" RESULT_VARIABLE result OUTPUT_VARIABLE report TIMEOUT 60)
        if(NOT result EQUAL 0 OR NOT report MATCHES "operation_identity=1" OR NOT report MATCHES "payload_identity=1" OR NOT report MATCHES "round_trip=1")
            message(FATAL_ERROR "Prepared mapping failed: ${result}: ${report}")
        endif()
    endforeach()
endforeach()
string(REPEAT "ABRACADABRA01234" 69906 input)
file(WRITE "${WORK}/input" "${input}")
execute_process(COMMAND "${BENCHMARK}" "${WORK}/input" reverse RESULT_VARIABLE result OUTPUT_VARIABLE report TIMEOUT 60)
if(NOT result EQUAL 0 OR NOT report MATCHES "frame_1_iteration_2_slot_2_rank=" OR NOT report MATCHES "verified_iterations=3")
    message(FATAL_ERROR "Multiframe mapping failed: ${result}: ${report}")
endif()
