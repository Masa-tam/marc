if(NOT DEFINED BENCHMARK OR NOT DEFINED WORK)
    message(FATAL_ERROR "Missing diagnostic or workspace")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/empty" "")
string(REPEAT "A" 259 run)
file(WRITE "${WORK}/run" "${run}")
string(REPEAT "abcabcabc0123456789" 227 data)
file(WRITE "${WORK}/small" "${data}")
string(REPEAT "A" 4194304 boundary)
file(WRITE "${WORK}/boundary" "${boundary}")
file(WRITE "${WORK}/multi" "${boundary}A")
foreach(member empty run small boundary multi)
    foreach(profile reference-0 finder-scratch reference-1)
        set(archive "${WORK}/${member}-${profile}.marc")
        foreach(mode verify encode decode)
            execute_process(COMMAND "${BENCHMARK}" "${WORK}/${member}" "${profile}" "${mode}" "${archive}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if(NOT result EQUAL 0 OR NOT output MATCHES "verified=1")
                message(FATAL_ERROR "${member}/${profile}/${mode}: ${result} ${error} ${output}")
            endif()
            foreach(field create_seconds prepare_seconds collect_seconds drain_seconds decode_process_seconds destroy_seconds prepare_calls collect_calls drain_calls decode_calls)
                if(NOT output MATCHES "${field}=[0-9]+")
                    message(FATAL_ERROR "Missing phase field ${field}: ${output}")
                endif()
            endforeach()
            if(mode STREQUAL "decode" OR member STREQUAL "empty")
                if(NOT output MATCHES "prepare_calls=0\n")
                    message(FATAL_ERROR "Unexpected preparation: ${output}")
                endif()
            elseif(member STREQUAL "multi")
                if(NOT output MATCHES "prepare_calls=2\n")
                    message(FATAL_ERROR "Missing final short-frame preparation: ${output}")
                endif()
            elseif(NOT output MATCHES "prepare_calls=1\n")
                message(FATAL_ERROR "Missing single-frame preparation: ${output}")
            endif()
        endforeach()
        file(SHA256 "${archive}" digest)
        if(profile STREQUAL "reference-0")
            set(expected "${digest}")
        elseif(NOT digest STREQUAL expected)
            message(FATAL_ERROR "Owner bytes differ")
        endif()
    endforeach()
endforeach()
