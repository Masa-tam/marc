file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "ABRACADABRA01234" 65537 input)
file(WRITE "${WORK}/input" "${input}")
file(WRITE "${WORK}/small" "abcdA0abcdB1abcdC2abcdA3")
foreach(allocation IN ITEMS forward reverse)
    foreach(execution IN ITEMS forward reverse)
        execute_process(COMMAND "${BENCHMARK}" "${WORK}/input" "${allocation}" "${execution}" --verify-only
            RESULT_VARIABLE result OUTPUT_VARIABLE report TIMEOUT 120)
        if(NOT result EQUAL 0 OR NOT report MATCHES "frame_1_size=16[\r\n]"
                OR NOT report MATCHES "verified_iterations=0" OR NOT report MATCHES "same_code_verified=1")
            message(FATAL_ERROR "Multiframe same-code verification failed: ${result}: ${report}")
        endif()
        execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" "${allocation}" "${execution}"
            RESULT_VARIABLE result OUTPUT_VARIABLE report TIMEOUT 120)
        if(NOT result EQUAL 0 OR NOT report MATCHES "verified_iterations=3" OR NOT report MATCHES "frame_identity=1"
                OR NOT report MATCHES "frame_0_iteration_2_slot_2_rank="
                OR NOT report MATCHES "iteration_2_slot_2_seconds=")
            message(FATAL_ERROR "Timed same-code replay failed: ${result}: ${report}")
        endif()
        foreach(slot RANGE 0 2)
            set(ranks)
            foreach(iteration RANGE 0 2)
                string(REGEX MATCH "frame_0_iteration_${iteration}_slot_${slot}_rank=([0-2])[\r\n]" found "${report}")
                if(NOT found)
                    message(FATAL_ERROR "Missing execution rank")
                endif()
                list(APPEND ranks "${CMAKE_MATCH_1}")
            endforeach()
            list(SORT ranks)
            if(NOT "${ranks}" STREQUAL "0;1;2")
                message(FATAL_ERROR "Each instance must occupy every execution rank: ${ranks}")
            endif()
        endforeach()
    endforeach()
endforeach()
file(WRITE "${WORK}/empty" "")
execute_process(COMMAND "${BENCHMARK}" "${WORK}/empty" forward forward RESULT_VARIABLE result)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Empty input must be rejected")
endif()
execute_process(COMMAND "${BENCHMARK}" "${WORK}/small" invalid forward RESULT_VARIABLE result)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Invalid allocation order must be rejected")
endif()
